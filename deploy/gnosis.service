[Unit]
Description=Gnosis research alpha API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gnosis
Group=gnosis
WorkingDirectory=/opt/gnosis
EnvironmentFile=/etc/gnosis/gnosis.env
Environment=HOME=/var/lib/gnosis PYTHONPATH=/opt/gnosis PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
UMask=0077
ExecStartPre=/opt/gnosis-venv/bin/python /opt/gnosis/scripts/check_production.py
ExecStart=/opt/gnosis-venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gnosis

[Install]
WantedBy=multi-user.target
