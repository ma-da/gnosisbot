# Copy to /etc/gnosis/gnosis.env (root:gnosis 0640); never commit real values.
# This file is both a systemd EnvironmentFile and a restricted shell fragment.
GNOSIS_DATA_DIR=/var/lib/gnosis
GNOSIS_DB_PATH=/var/lib/gnosis/gnosis.sqlite3
GNOSIS_WEB_ORIGIN=https://gnosis.bot
GNOSIS_PUBLIC_BASE_URL=https://gnosis.bot
GNOSIS_ALLOW_INSECURE_COOKIE=0
GNOSIS_COOLDOWN_SECONDS=60
GNOSIS_ENABLE_ACCOUNTS_API=1
GNOSIS_ENABLE_RUNES=1
GNOSIS_ENABLE_RUNE_DEMO=1
# Turn on each provider independently after operator acceptance.
GNOSIS_ENABLE_QCI=0
QCI_API_TOKEN=""
GNOSIS_ENABLE_NIST=0
GNOSIS_ENABLE_RUNE_NIST=0
GNOSIS_ENABLE_IBM_PAST=0
GNOSIS_ENABLE_RUNE_PAST=0
# Paid submissions and privileged trials must remain disabled in alpha.
GNOSIS_ENABLE_IBM_ADMIN_TRIAL=NO
GNOSIS_ENABLE_IBM_LIVE_SUBMISSION=NO
GNOSIS_ENABLE_IBM_AUTO_SUBMIT=NO
GNOSIS_ENABLE_IBM_PILOT=NO
GNOSIS_ENABLE_CONSULTATION_SANDBOX=0
GNOSIS_IBM_MAX_INFLIGHT=1
GNOSIS_IBM_REQUEST_OVERHEAD_SECONDS=2
GNOSIS_IBM_INSTANCE=""
GNOSIS_IBM_INSTANCE_LABEL='Configured instance'
# Account contact and completion emails. Preserve existing encryption key on migration.
GNOSIS_ENABLE_EMAIL_VERIFICATION=NO
GNOSIS_ENABLE_COMPLETION_EMAIL=NO
GNOSIS_ENABLE_TRIAL_EMAIL=NO
GNOSIS_TEST_NOTIFICATION_EMAIL=""
GNOSIS_RESEND_FROM='Gnosis <readings@gnosis.bot>'
RESEND_API_KEY=""
GNOSIS_CONTACT_ENCRYPTION_KEY=""
# Enable admin dashboard only after access review. Admin provisioning is always explicit CLI.
GNOSIS_ENABLE_ADMIN_DASHBOARD=0
GNOSIS_PROVISION_ADMIN=NO
GNOSIS_OTS_EXECUTABLE=/opt/gnosis-ots/bin/ots
GNOSIS_BTC_VERIFIER=core
GNOSIS_FORMSPREE_FORM_ID=""
GNOSIS_FORMSPREE_API_KEY=""
# Optional SMTP volume alert utility (not enabled by service templates).
GNOSIS_ALERT_SMTP_HOST=""
GNOSIS_ALERT_SMTP_PORT=465
GNOSIS_ALERT_SMTP_USER=""
GNOSIS_ALERT_SMTP_PASSWORD=""
GNOSIS_ALERT_FROM=""
GNOSIS_ALERT_TO=""
